# Email Configuration for BHA Electrical LLC
# Update these values with your actual email service credentials

# Email Service Provider (gmail, outlook, sendgrid, etc.)
EMAIL_SERVICE=gmail

# Your email address (from)
EMAIL_USER=your-email@gmail.com

# Email password or app-specific password
# For Gmail: Use an App Password (requires 2FA enabled)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your-app-password-here

# Business email to receive service requests
BUSINESS_EMAIL=info@bhaelectrical.com

# Server Configuration
PORT=3000
NODE_ENV=development
